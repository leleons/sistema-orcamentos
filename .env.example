# Banco de dados
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=sua-senha-forte
MYSQL_DATABASE=banco_dsystem

# Administrador inicial
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha

# URL publica do sistema
APP_BASE_URL=https://seu-dominio.com.br

# WhatsApp
WHATSAPP_OFICIAL=5531999999999
WHATSAPP_API_NUMERO=5531999999999

# E-mail SMTP
SMTP_HOST=smtp.seu-provedor.com.br
SMTP_PORT=587
SMTP_USER=atendimento@seu-dominio.com.br
SMTP_PASSWORD=sua-senha-ou-senha-de-app
SMTP_FROM=atendimento@seu-dominio.com.br

# Uploads
MAX_UPLOAD_BANCO_BYTES=8388608
DSYSTEM_UPLOAD_MAX_BYTES=7516192768

# NFS-e / Prefeitura
NFSE_CNPJ=00000000000000
NFSE_INSCRICAO_MUNICIPAL=00000000000
NFSE_AMBIENTE=homologacao
NFSE_CERTIFICADO_PFX=/opt/orcamento/certificados/certificado_dsystem.pfx
NFSE_MODO_EMISSAO=nacional
NFSE_CODIGO_MUNICIPIO=3106200
NFSE_DPS_SERIE=1
# Obrigatorio: 1=Nao optante, 2=MEI, 3=ME/EPP
NFSE_OP_SIMPLES_NACIONAL=
NFSE_REG_APURACAO_SIMPLES=
NFSE_REGIME_ESPECIAL_NACIONAL=0
# Vazio usa automaticamente o endpoint oficial de homologacao/producao
NFSE_NACIONAL_ENDPOINT=
# Usuário dedicado do computador da recepção (troca obrigatória no primeiro acesso)
RECEPCAO_USERNAME=recepcao
RECEPCAO_PASSWORD=defina-uma-senha-temporaria-forte
